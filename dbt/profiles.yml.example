# Copy to ~/.dbt/profiles.yml (not committed; real credentials are never
# checked in, and these are throwaway dev credentials for a local WSL2
# Postgres instance anyway).
idqg:
  target: dev
  outputs:
    dev:
      type: postgres
      host: localhost
      port: 5432
      user: idqg
      password: idqg_dev_pw
      dbname: idqg
      schema: public
      threads: 4
